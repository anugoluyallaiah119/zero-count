# Zero Count V2 — staging environment template (E4.3).
# Copy to .env and fill in. NEVER commit the filled .env (gitignored).
# Generate secrets with: openssl rand -base64 48

# Public domain for the API (DNS must point at the staging host).
# Used by Caddy for automatic TLS: https://<API_DOMAIN>
API_DOMAIN=api.staging.zerocount.example.com

# Release version stamp (surfaced at /actuator/info).
APP_VERSION=2.0.0-staging

# --- Postgres ---
DB_NAME=zerocount
DB_USER=zerocount
DB_PASSWORD=__generate_me__

# --- Auth ---
# JWT signing secret — REQUIRED, >= 32 bytes, unique per environment.
JWT_SECRET=__generate_me__

# dev    = fixed-code OTP (DEV_OTP_CODE) for QA without SMS costs.
# firebase = production path; requires FIREBASE_PROJECT_ID.
AUTH_PROVIDER=dev
DEV_OTP_CODE=123456
FIREBASE_PROJECT_ID=
